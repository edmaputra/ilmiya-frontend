# ─────────────────────────────────────────────────────────────────────────────
# Ilmiya Frontend — Environment Configuration
# Copy this file to .env and fill in your values.
# NOTE: Flutter web cannot read .env files at runtime.
# Pass these as --dart-define flags when running or building the app:
#
#   flutter run -d chrome \
#     --dart-define=ILMIYA_API_BASE_URL=http://localhost:9090 \
#     --dart-define=ILMIYA_DEFAULT_TENANT_ID=tenant-yourschool-001
#
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend REST API (no trailing slash).
# Defaults to http://localhost:8080 if not provided.
ILMIYA_API_BASE_URL=http://localhost:8080

# Default tenant ID for multi-tenant environments.
# Must match a valid tenant registered in the backend.
ILMIYA_DEFAULT_TENANT_ID=tenant-lincoln-high-001
